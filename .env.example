# Contact and social links. Read once in src/content/site.ts and validated with Zod.
# NEXT_PUBLIC_ prefix: these are public values that reach the browser.
# Phase 1 has no secrets. Replace every value below before going public (see docs/RUNBOOK.md).

# E.164 digits, with or without the leading +. [TODO] owner's WhatsApp number
NEXT_PUBLIC_WHATSAPP_NUMBER=447000000000
# [TODO] owner's email
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Leave a social URL empty to hide that icon. [TODO] real handles
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/thegatheringco
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/thegatheringco
NEXT_PUBLIC_TIKTOK_URL=
# Canonical site URL, used for metadata, sitemap and robots. Inferred domain.
NEXT_PUBLIC_SITE_URL=https://thegatheringco.co.uk
